    {
      "parameters": {
        "jsCode": "// Ambil data formulir dan data karyawan dari Google Sheets\nconst form = $('On form submission').first().json;\nconst rows = $input.all().map(item => item.json);\nconst employee = rows[0];\n\nif (!employee) {\n  return [{\n    json: {\n      ...form,\n      employeeFound: false,\n      isApprovedSystem: false,\n      validationMessage: 'Email karyawan tidak ditemukan di DB_Karyawan.',\n      requestId: `CUTI-${Date.now()}`,\n      durationRequested: 0\n    }\n  }];\n}\n\nconst email = form['Email Karyawan'];\nconst startRaw = form['Tanggal Mulai'];\nconst endRaw = form['Tanggal Selesai'];\nconst start = new Date(startRaw);\nconst end = new Date(endRaw);\n\nif (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || end < start) {\n  throw new Error('Tanggal mulai/selesai tidak valid. Tanggal selesai harus sama dengan atau setelah tanggal mulai.');\n}\n\n// Menghitung durasi kalender secara inklusif.\nconst startUTC = Date.UTC(start.getFullYear(), start.getMonth(), start.getDate());\nconst endUTC = Date.UTC(end.getFullYear(), end.getMonth(), end.getDate());\nconst durationRequested = Math.floor((endUTC - startUTC) / 86400000) + 1;\n\nconst saldoCuti = Number(employee.Saldo_Cuti ?? 0);\nconst managerEmail = employee.Manager_Email ?? '';\nconst employeeName = employee.Nama ?? employee.Nama_Karyawan ?? email;\nconst isApprovedSystem = saldoCuti >= durationRequested && durationRequested > 0;\n\nreturn [{\n  json: {\n    ...form,\n    employeeFound: true,\n    employeeName,\n    email,\n    managerEmail,\n    saldoCuti,\n    durationRequested,\n    isApprovedSystem,\n    validationMessage: isApprovedSystem\n      ? 'Saldo cuti mencukupi. Menunggu persetujuan manajer.'\n      : 'Saldo cuti tidak mencukupi atau data saldo tidak valid.',\n    requestId: `CUTI-${Date.now()}`\n  }\n}];"
      },
