{
  "name": "Tugas 3 - AI Video Generator to Google Drive",
  "nodes": [
    {
      "parameters": {
        "formTitle": "AI Video Generator",
        "formDescription": "Masukkan prompt dan gambar untuk membuat video AI.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Prompt",
              "requiredField": true
            },
            {
              "fieldLabel": "Image",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "form-trigger",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.kie.ai/api/v1/video/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_KIE_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'grok-imagine-video-1-5-preview', input: { prompt: $json.Prompt, image_urls: [$json.Image], aspect_ratio: 'auto', resolution: '480p', duration: 8 } }) }}",
        "options": {}
      },
      "id": "http-post-generate",
      "name": "HTTP Request - Generate Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "wait-20",
      "name": "Wait 20 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        460,
        0
      ],
      "webhookId": "wait-video-status"
    },
    {
      "parameters": {
        "url": "https://api.kie.ai/api/v1/video/record-info?taskId={{$json.data.taskId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_KIE_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "http-get-status",
      "name": "HTTP Request - Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.state }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-success",
      "name": "IF - Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = JSON.parse($json.data.resultJson);\\n\\nreturn [{ json: { videoUrl: result.resultUrls?.[0] || null } }];"
      },
      "id": "parse-video-url",
      "name": "Code - Parse Video URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -120
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.videoUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-video",
      "name": "HTTP Request - Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        -120
      ]
    },
    {
      "parameters": {
        "name": "={{ 'AI Video ' + $now.toFormat('yyyyLLdd-HHmmss') + '.mp4' }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_GOOGLE_DRIVE_FOLDER_ID"
        },
        "options": {}
      },
      "id": "google-drive-upload",
      "name": "Google Drive - Upload Video",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1560,
        -120
      ]
    }
  ],
  "connections": {
    "On form submission": {
      "main": [
        [
          {
            "node": "HTTP Request - Generate Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Generate Video": {
      "main": [
        [
          {
            "node": "Wait 20 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 20 seconds": {
      "main": [
        [
          {
            "node": "HTTP Request - Check Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Check Status": {
      "main": [
        [
          {
            "node": "IF - Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Success": {
      "main": [
        [
          {
            "node": "Code - Parse Video URL",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 20 seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Parse Video URL": {
      "main": [
        [
          {
            "node": "HTTP Request - Download Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Download Video": {
      "main": [
        [
          {
            "node": "Google Drive - Upload Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "tugas3-video-workflow",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}