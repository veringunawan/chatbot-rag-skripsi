    {
      "parameters": {
        "jsCode": "// DateTime (Luxon) is available globally in the n8n Code node\nconst now = DateTime.now().setZone('Asia/Jakarta');\n\nreturn items.filter(item => {\n  const status = String(item.json.Status ?? '')\n    .trim()\n    .toLowerCase();\n\n  const date = String(item.json['Scheduled Date'] ?? '').trim();\n  const time = String(item.json['Scheduled Time'] ?? '').trim();\n\n  const [day, month, year] = date.split('/').map(Number);\n  const [hour, minute, second] = time.split(':').map(Number);\n\n  const scheduled = DateTime.fromObject(\n    {\n      year,\n      month,\n      day,\n      hour,\n      minute,\n      second: second || 0\n    },\n    {\n      zone: 'Asia/Jakarta'\n    }\n  );\n\n  return (\n    (status === '' || status === 'pending') &&\n    scheduled.isValid &&\n    scheduled <= now\n  );\n});"
      },
