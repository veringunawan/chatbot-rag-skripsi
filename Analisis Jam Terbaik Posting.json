    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\n// Hitung engagement tiap postingan\nconst data = rows.map(item => {\n  const row = item.json;\n\n  const likes = Number(row.Likes) || 0;\n  const comments = Number(row.Comments) || 0;\n  const shares = Number(row.Shares) || 0;\n  const hour = Number(row[\"Jam Posting\"]);\n\n  const engagement = likes + (comments * 2) + (shares * 3);\n\n  return {\n    jam: hour,\n    likes,\n    comments,\n    shares,\n    engagement\n  };\n});\n\n// Kelompokkan berdasarkan jam posting\nconst grouped = {};\n\nfor (const post of data) {\n  if (!grouped[post.jam]) {\n    grouped[post.jam] = {\n      total: 0,\n      jumlah: 0\n    };\n  }\n\n  grouped[post.jam].total += post.engagement;\n  grouped[post.jam].jumlah += 1;\n}\n\n// Hitung rata-rata engagement per jam\nconst hasil = Object.entries(grouped).map(([jam, value]) => ({\n  jam: Number(jam),\n  rataRataEngagement: Number(\n    (value.total / value.jumlah).toFixed(2)\n  ),\n  jumlahPosting: value.jumlah\n}));\n\n// Urutkan dari engagement tertinggi\nhasil.sort(\n  (a, b) => b.rataRataEngagement - a.rataRataEngagement\n);\n\n// Ambil 5 jam terbaik\nreturn hasil.slice(0, 5).map((item, index) => ({\n  json: {\n    ranking: index + 1,\n    jamPosting: item.jam,\n    rataRataEngagement: item.rataRataEngagement,\n    jumlahPosting: item.jumlahPosting\n  }\n}));"
      },
