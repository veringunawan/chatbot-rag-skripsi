        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json.data;\n\n  // Parsing respons JSON dari KIE AI\n  const result = typeof data.resultJson === 'string'\n    ? JSON.parse(data.resultJson)\n    : data.resultJson;\n\n  // Mengambil array URL gambar\n  const urls = result.resultUrls || [];\n\n  // Memilih URL gambar yang valid\n  const imageUrl = urls.find(url =>\n    typeof url === 'string' &&\n    /^https?:\\/\\/.+/i.test(url)\n  );\n\n  if (!imageUrl) {\n    throw new Error('URL gambar tidak ditemukan!');\n  }\n\n  return {\n    json: {\n      taskId: data.taskId,\n      state: data.state,\n      imageUrl: imageUrl\n    }\n  };\n});\n"
