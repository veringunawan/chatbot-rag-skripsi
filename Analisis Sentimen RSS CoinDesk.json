    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst norm = v => String(v ?? '').trim().toLowerCase();\nconst positive = rows.filter(r => norm(r.Sentiment) === 'positive').length;\nconst negative = rows.filter(r => norm(r.Sentiment) === 'negative').length;\nconst neutral = rows.filter(r => norm(r.Sentiment) === 'neutral').length;\nconst total = positive + negative + neutral;\nconst pct = n => total ? Number((n / total * 100).toFixed(1)) : 0;\nreturn [{json:{total, positive, negative, neutral, positivePercent:pct(positive), negativePercent:pct(negative), neutralPercent:pct(neutral), statsText:`Total berita: ${total}\\nPositive: ${positive} (${pct(positive)}%)\\nNegative: ${negative} (${pct(negative)}%)\\nNeutral: ${neutral} (${pct(neutral)}%)`}}];"
      },
