    {
      "parameters": {
        "jsCode": "\nfunction getValue(obj, names) {\n  for (const name of names) {\n    const key = Object.keys(obj).find(\n      k => k.trim().toLowerCase() === name.toLowerCase()\n    );\n\n    if (key && obj[key] != null && String(obj[key]).trim() !== '') {\n      return String(obj[key]).trim();\n    }\n  }\n  return '';\n}\n\nconst raw = $('Sheet Onboarding Karyawan').first().json;\n\nconst employee = {\n  first_name: getValue(raw, ['First Name', 'first_name']),\n  last_name: getValue(raw, ['Last Name', 'last_name']),\n  email: getValue(raw, ['Email', 'email', 'Email Address']),\n  start_date: getValue(raw, ['Start Date', 'start_date']),\n  position: getValue(raw, ['Position', 'position']),\n  full_name: getValue(raw, ['Full Name', 'full_name'])\n};\n\nif (!employee.full_name) {\n  employee.full_name =\n    `${employee.first_name} ${employee.last_name}`.trim();\n}\n\nconst tasks = $('Checklist').all().map(item => {\n  const row = item.json;\n  return getValue(row, [\n    'Checklist Onboarding Karyawan',\n    'Checklist',\n    'Task',\n    'Tugas'\n  ]) || String(Object.values(row)[0] || '').trim();\n}).filter(Boolean);\n\nreturn [{\n  json: {\n    sheet: employee,\n    checklist: [...new Set(tasks)]\n  }\n}];\n"
      },
