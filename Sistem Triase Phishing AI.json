    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const teks = String($json.text || '');\nconst email = $('Cek Allowlist').item.json;\n\n// Cari pola \"SKOR: 8\" atau \"Skor 8/10\"; jika tidak ada, ambil angka 1-10 pertama\nlet match = teks.match(/skor\\s*[:=]?\\s*(10|[1-9])/i);\nif (!match) match = teks.match(/\\b(10|[1-9])\\s*(?:\\/\\s*10)?\\b/);\nconst skor = match ? parseInt(match[1], 10) : 0;\n\nconst alasanMatch = teks.match(/alasan\\s*[:=]?\\s*([\\s\\S]*)/i);\nconst alasan = alasanMatch ? alasanMatch[1].trim() : teks.trim();\n\nreturn {\n  json: {\n    skor: skor,\n    skorDitemukan: Boolean(match),\n    alasan: alasan,\n    responsAI: teks,\n    messageId: email.id,\n    threadId: email.threadId,\n    pengirim: email.from?.value?.[0]?.address || '',\n    namaPengirim: email.from?.value?.[0]?.name || '',\n    subjek: email.subject || '',\n  },\n};"
      },
