    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfunction sma(values, period) { const a=values.slice(-period); return a.length===period ? a.reduce((s,v)=>s+v,0)/period : null; }\nfunction rsi(values, period=14) {\n if(values.length<=period) return null;\n let gains=0, losses=0;\n for(let i=values.length-period;i<values.length;i++){ const d=values[i]-values[i-1]; if(d>0) gains+=d; else losses-=d; }\n const avgGain=gains/period, avgLoss=losses/period;\n if(avgLoss===0) return 100;\n const rs=avgGain/avgLoss; return 100-(100/(1+rs));\n}\nreturn items.map(item=>{\n const r=item.json.chart?.result?.[0];\n if(!r) return {json:{symbol:'UNKNOWN',error:item.json.chart?.error?.description||'Data tidak tersedia'}};\n const closes=(r.indicators?.quote?.[0]?.close||[]).filter(v=>v!==null);\n const price=closes.at(-1), ma50=sma(closes,50), ma200=sma(closes,200), valueRsi=rsi(closes,14);\n let signal='Tidak ada sinyal saat ini';\n if(valueRsi!==null && valueRsi<30) signal='🟢 RSI Oversold (Potensi Buy)';\n else if(valueRsi!==null && valueRsi>70) signal='🔴 RSI Overbought (Potensi Sell)';\n else if(ma50!==null && ma200!==null && ma50>ma200) signal='🟢 Golden Cross (Buy Signal)';\n else if(ma50!==null && ma200!==null && ma50<ma200) signal='🔴 Death Cross (Sell Signal)';\n return {json:{symbol:'BTC-USD',price,rsi:valueRsi,ma50,ma200,signal}};\n});"
      },
