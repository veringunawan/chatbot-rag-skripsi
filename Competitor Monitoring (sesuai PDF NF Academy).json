    {
      "parameters": {
        "jsCode": "const brands=[\"NF Academy\",\"BISA AI\",\"Vinix 7\"];\nconst items=$input.all(); let articles=[];\nitems.forEach((it,i)=>{for(const a of (it.json.organic||[])){articles.push({brand:brands[i],title:a.title||\"\",snippet:a.snippet||\"\",link:a.link||\"\",processedAt:new Date().toISOString()});}});\nconst counts=Object.fromEntries(brands.map(b=>[b,articles.filter(a=>a.brand===b).length]));\nconst total=articles.length; const sov=Object.fromEntries(brands.map(b=>[b,total?Number((counts[b]/total*100).toFixed(1)):0]));\nreturn [{json:{brands,articles,metrics:{totalMentions:total,counts,sov},combinedText:articles.map(a=>`[${a.brand}] ${a.title} ${a.snippet}`).join(\"\\n\")}}];"
      },
