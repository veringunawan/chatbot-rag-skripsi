    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst tanggal = data.Tanggal || new Date().toLocaleString('id-ID');\nconst analisis = data['Analisis AI'] || data.output || 'Analisis belum tersedia';\n\nconst html = `\n<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Competitor Monitoring Report</title>\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  margin: 40px;\n  color: #222;\n}\nh1 {\n  color: #1e40af;\n}\n.header {\n  background: #1e40af;\n  color: white;\n  padding: 20px;\n  border-radius: 8px;\n}\n.content {\n  margin-top: 25px;\n  line-height: 1.7;\n  white-space: pre-wrap;\n}\n.footer {\n  margin-top: 30px;\n  font-size: 12px;\n  color: #777;\n}\n</style>\n</head>\n<body>\n<div class=\"header\">\n<h1>Competitor Monitoring Report</h1>\n<p>Tanggal: ${tanggal}</p>\n</div>\n\n<div class=\"content\">\n${analisis}\n</div>\n\n<div class=\"footer\">\nGenerated automatically by n8n Competitor Monitoring\n</div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    html,\n    tanggal\n  }\n}];"
      },
