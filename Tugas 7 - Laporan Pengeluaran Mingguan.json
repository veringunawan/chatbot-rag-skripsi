    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst today = new Date();\ntoday.setHours(23, 59, 59, 999);\n\nconst sevenDaysAgo = new Date(today);\nsevenDaysAgo.setDate(today.getDate() - 7);\nsevenDaysAgo.setHours(0, 0, 0, 0);\n\nfunction parseDate(value) {\n  if (!value) return null;\n\n  const match = String(value).trim().match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n\n  if (match) {\n    return new Date(\n      Number(match[3]),\n      Number(match[2]) - 1,\n      Number(match[1])\n    );\n  }\n\n  const date = new Date(value);\n  return isNaN(date.getTime()) ? null : date;\n}\n\nconst expenses = items\n  .map(item => item.json)\n  .filter(row => {\n    const date = parseDate(row.Tanggal);\n    return date && date >= sevenDaysAgo && date <= today;\n  });\n\nconst categoryTotals = {};\nlet grandTotal = 0;\n\nlet reportText = \"LAPORAN PENGELUARAN 7 HARI TERAKHIR\\n\\n\";\n\nfor (const row of expenses) {\n  const tanggal = row.Tanggal || \"-\";\n  const kategori = row.Kategori || \"Lain-lain\";\n  const deskripsi = row.Deskripsi || \"-\";\n  const penerima = row.Penerima || \"-\";\n\n  // Membaca nama kolom persis seperti Google Sheets\n  const jumlah = Number(\n    String(row[\"Jumlah (IDR)\"] ?? row.Jumlah ?? 0)\n      .replace(/[^\\d.-]/g, \"\")\n  ) || 0;\n\n  grandTotal += jumlah;\n\n  categoryTotals[kategori] =\n    (categoryTotals[kategori] || 0) + jumlah;\n\n  reportText +=\n    `Tanggal: ${tanggal}\\n` +\n    `Kategori: ${kategori}\\n` +\n    `Deskripsi: ${deskripsi}\\n` +\n    `Penerima: ${penerima}\\n` +\n    `Jumlah: Rp${jumlah.toLocaleString(\"id-ID\")}\\n\\n`;\n}\n\nconst sortedCategories = Object.entries(categoryTotals)\n  .sort((a, b) => b[1] - a[1]);\n\nreportText += \"\\nRINGKASAN KATEGORI:\\n\";\n\nfor (const [category, total] of sortedCategories) {\n  reportText +=\n    `${category}: Rp${total.toLocaleString(\"id-ID\")}\\n`;\n}\n\nreportText +=\n  `\\nTOTAL PENGELUARAN: Rp${grandTotal.toLocaleString(\"id-ID\")}\\n`;\n\nreportText +=\n  `JUMLAH TRANSAKSI: ${expenses.length}\\n`;\n\nreportText +=\n  `KATEGORI TERBESAR: ${sortedCategories[0]?.[0] || \"-\"}\\n`;\n\nreturn [{\n  json: {\n    hasExpenses: expenses.length > 0,\n    totalTransactions: expenses.length,\n    grandTotal,\n    categoryTotals,\n    reportText\n  }\n}];\n"
      },
