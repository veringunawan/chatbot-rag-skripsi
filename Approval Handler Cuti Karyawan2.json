    {
      "parameters": {
        "jsCode": "// Ambil saldo terbaru dari DB_Karyawan dan parameter keputusan dari Webhook.\nconst employee = $input.first()?.json;\nconst query = $('Webhook').first().json.query || {};\n\nif (!employee) {\n  throw new Error('Data karyawan tidak ditemukan. Periksa parameter email dan sheet DB_Karyawan.');\n}\n\nconst days = Number(query.days);\nconst oldBalance = Number(employee.Saldo_Cuti);\n\nif (!query.email || !query.id) {\n  throw new Error('Parameter email atau id tidak ditemukan pada URL approval.');\n}\nif (!Number.isFinite(days) || days <= 0) {\n  throw new Error('Parameter days tidak valid.');\n}\nif (!Number.isFinite(oldBalance) || oldBalance < days) {\n  throw new Error('Saldo cuti terbaru tidak mencukupi. Saldo tidak diubah.');\n}\n\nconst newBalance = oldBalance - days;\nreturn [{\n  json: {\n    email: query.email,\n    requestId: query.id,\n    daysRequested: days,\n    oldBalance,\n    newBalance,\n    managerDecision: 'Approved'\n  }\n}];"
      },
