    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst end = new Date(now); end.setHours(23,59,59,999);\nconst start = new Date(now); start.setDate(start.getDate()-7); start.setHours(0,0,0,0);\nfunction parseDate(v) {\n if (v === undefined || v === null || String(v).trim()==='') return null;\n const s=String(v).trim();\n const m=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n if(m){ const d=new Date(Number(m[3]),Number(m[2])-1,Number(m[1]));\n   if(d.getFullYear()!==Number(m[3])||d.getMonth()!==Number(m[2])-1||d.getDate()!==Number(m[1])) return null;\n   return d; }\n const d=new Date(v); return Number.isNaN(d.getTime())?null:d;\n}\nfunction fmtDate(d){return d.toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric',timeZone:'Asia/Jakarta'});}\nfunction amount(v){ if(typeof v==='number') return v; const s=String(v??'').trim().replace(/\\s/g,'').replace(/Rp/gi,'');\n  // Support Indonesian formatted numbers: 1.250.000 or 1.250,50\n  if(/^\\-?\\d{1,3}(\\.\\d{3})+(,\\d+)?$/.test(s)) return Number(s.replace(/\\./g,'').replace(',','.'));\n  if(/^\\-?\\d+(,\\d+)?$/.test(s)) return Number(s.replace(',','.'));\n  return Number(s.replace(/[^\\d.-]/g,''))||0;\n}\nconst expenses=[];\nfor(const item of items){const r=item.json; const dt=parseDate(r.Tanggal??r.tanggal??r.Date??r.date);\n if(!dt||dt<start||dt>end) continue;\n expenses.push({date:dt,category:r.Kategori??r.kategori??r.Category??'Tidak diketahui',description:r.Deskripsi??r.deskripsi??r.Description??r.Keterangan??'-',amount:amount(r.Jumlah??r.jumlah??r.Nominal??r.nominal??r.Amount??r.amount)});\n}\nexpenses.sort((a,b)=>a.date-b.date);\nconst total=expenses.reduce((s,e)=>s+e.amount,0);\nconst promptData=expenses.length?expenses.map(e=>`Tanggal: ${fmtDate(e.date)}\\nKategori: ${e.category}\\nDeskripsi: ${e.description}\\nJumlah: Rp${e.amount.toLocaleString('id-ID')}`).join('\\n-------------------------\\n')+`\\n\\nTOTAL PENGELUARAN: Rp${total.toLocaleString('id-ID')}\\nJUMLAH TRANSAKSI: ${expenses.length}`:'Tidak ditemukan pengeluaran dalam 7 hari terakhir.';\nreturn [{json:{hasExpenses:expenses.length>0,jumlahTransaksi:expenses.length,totalPengeluaran:total,promptData,startDate:fmtDate(start),endDate:fmtDate(end)}}];"
      },
